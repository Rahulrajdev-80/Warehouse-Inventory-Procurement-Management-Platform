# Application Configuration
APP_NAME="Warehouse Inventory & Procurement Platform"
ENVIRONMENT="development"
DEBUG=True
SECRET_KEY="supersecretjwtkeyforwarehouseinventoryprocurementplatformchangeinprod"
ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=7

# Database Settings
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_SERVER=localhost
POSTGRES_PORT=5432
POSTGRES_DB=warehouse_db
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/warehouse_db
SYNC_DATABASE_URL=postgresql+psycopg2://postgres:postgres@localhost:5432/warehouse_db

# Redis Settings
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_URL=redis://localhost:6379/0

# Celery Configuration
CELERY_BROKER_URL=redis://localhost:6379/1
CELERY_RESULT_BACKEND=redis://localhost:6379/2

# Email Settings (Mock SMTP / Notification)
SMTP_SERVER=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=noreply@warehouseinventory.com
SMTP_PASSWORD=password
EMAILS_FROM_EMAIL=noreply@warehouseinventory.com
